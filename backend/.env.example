# Prefer Neon's pooled host (-pooler) for lower connect latency from remote clients.
# Example: postgresql+asyncpg://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/DBNAME?ssl=require
database_url=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?ssl=require
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
